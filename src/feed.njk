---
pagination:
  data: blogFeedPages
  size: 1
  alias: feedPage
permalink: "{{ feedPage.permalink }}"
layout: false
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ feedPage.lang }}">
  <title>{{ feedPage.title | xmlEscape }}</title>
  <subtitle>{{ feedPage.subtitle | xmlEscape }}</subtitle>
  <id>{{ feedPage.archiveUrl | absoluteUrl(seo.origin) | xmlEscape }}</id>
  <link href="{{ feedPage.archiveUrl | absoluteUrl(seo.origin) | xmlEscape }}" />
  <link rel="self" type="application/atom+xml" href="{{ feedPage.permalink | absoluteUrl(seo.origin) | xmlEscape }}" />
  <updated>{{ feedPage.posts[0].date | isoLjubljana }}</updated>
  <author><name>Žan Kafol</name><uri>{{ '/' | absoluteUrl(seo.origin) | xmlEscape }}</uri></author>
  {% for post in feedPage.posts %}
  <entry>
    <title>{{ post.title | xmlEscape }}</title>
    <id>{{ post.permalink | absoluteUrl(seo.origin) | xmlEscape }}</id>
    <link href="{{ post.permalink | absoluteUrl(seo.origin) | xmlEscape }}" />
    <published>{{ post.date | isoLjubljana }}</published>
    <updated>{{ (post.modified or post.date) | isoLjubljana }}</updated>
    <summary type="text">{{ (post.seoDescription or post.summary) | xmlEscape }}</summary>
  </entry>
  {% endfor %}
</feed>
